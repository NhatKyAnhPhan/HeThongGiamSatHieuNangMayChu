<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bộ kiểm thử tự động (C#): API, logic giao diện và giao diện WinForms.
       Dùng lại mã nguồn của project chính bằng cách link file, nên không cần sửa project chính. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Nhom3_NoSQL.Tests</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Nhom3_NoSQL\Backend\**\*.cs" LinkBase="App\Backend" />
    <Compile Include="..\Nhom3_NoSQL\Database\**\*.cs" LinkBase="App\Database" />
    <Compile Include="..\Nhom3_NoSQL\Frontend\**\*.cs" Exclude="..\Nhom3_NoSQL\Frontend\ScreenshotRunner.cs" LinkBase="App\Frontend" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.11.1" />
    <PackageReference Include="NEST" Version="7.17.5" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
</Project>
